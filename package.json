{
  "name": "react-edit-text",
  "version": "6.0.0",
  "description": "Simple editable text component for React",
  "author": "Brian Min <bymi15@yahoo.com> (https://github.com/bymi15)",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/index.css": "./dist/index.css",
    "./style.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.d.ts','dist/index.d.mts')\"",
    "dev": "vite --config example/vite.config.ts",
    "prepare": "npm run build",
    "test": "run-s lint typecheck test:unit build check:package",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check:package": "publint --strict && attw --pack . --exclude-entrypoints ./dist/index.css ./style.css",
    "example:build": "vite build --config example/vite.config.ts",
    "predeploy": "npm run example:build",
    "deploy": "gh-pages -d example/build",
    "semantic-release": "semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bymi15/react-edit-text.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.com/"
  },
  "keywords": [
    "react",
    "edit",
    "text",
    "react-edit-text",
    "editable",
    "inline-edit",
    "input",
    "textbox",
    "textarea"
  ],
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-syntax-highlighter": "^16.1.2",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.1"
  }
}
